# ---- Publisher material (reference only; never commit) ----
/rulebook.pdf
/cards.pdf

# ---- Rust (engine/) ----
target/
**/*.rs.bk
*.pdb
# WASM build output (regenerated by the build)
engine/crates/*/pkg/
# ts-rs default export directory (the app build sets TS_RS_EXPORT_DIR)
engine/crates/wwd-core/bindings/

# ---- Node / web (app/) ----
node_modules/
.pnpm-store/
dist/
build/
.svelte-kit/
.vite/
coverage/
*.tsbuildinfo
npm-debug.log*
pnpm-debug.log*
yarn-error.log*

# ---- Testing ----
playwright-report/
test-results/
blob-report/
playwright/.cache/

# ---- Cloudflare / local servers ----
.wrangler/
.dev.vars
*.sqlite
*.sqlite-journal
# Node referee room saves (contain seat tokens and PINs)
/data/
app/packages/referee-node/data/

# ---- Secrets & local config ----
.env
.env.*
!.env.example
# The web app's per-mode defaults hold only public referee URLs
!app/apps/web/.env.development
!app/apps/web/.env.production

# ---- Editors & OS ----
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini

# ---- Claude Code local settings ----
.claude/settings.local.json

# ---- Generated (app) ----
app/packages/engine/src/generated/

# Files written by package build scripts
app/packages/*/src/generated/
