{
  "name": "@wwd/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/check-ja-fonts.mjs && vite",
    "build": "node scripts/check-ja-fonts.mjs && vite build",
    "preview": "vite preview",
    "test": "node scripts/check-ja-fonts.mjs && vitest run",
    "e2e": "playwright test",
    "lint": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && prettier --check .",
    "e2e:online": "playwright test --config playwright.online.config.ts",
    "e2e:parity": "playwright test --config playwright.parity.config.ts",
    "e2e:pwa": "playwright test --config playwright.pwa.config.ts",
    "icons": "node scripts/icons.mjs",
    "visual": "node scripts/visual.mjs",
    "transcript": "node scripts/transcript.mjs",
    "fonts:ja": "node scripts/subset-ja-fonts.mjs"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible-next": "5.3.0",
    "@fontsource/lexend": "5.3.0",
    "@fontsource/marcellus": "5.3.0",
    "@fontsource/opendyslexic": "5.3.0",
    "@wwd/client-core": "workspace:*",
    "@wwd/engine": "workspace:*",
    "@wwd/protocol": "workspace:*",
    "@wwd/referee-memory": "workspace:*",
    "@wwd/transport": "workspace:*",
    "idb": "8.0.3",
    "uqr": "0.1.3",
    "workbox-window": "7.4.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "^1.65.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.0",
    "@wwd/referee-cloudflare": "workspace:*",
    "@wwd/referee-node": "workspace:*",
    "fake-indexeddb": "6.2.7",
    "jsdom": "^26.1.0",
    "prettier-plugin-svelte": "^3.5.2",
    "svelte": "^5.59.1",
    "svelte-check": "^4.3.0",
    "typescript": "^5.6.0",
    "vite": "^7.3.0",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "^3.0.0",
    "workbox-build": "7.4.1",
    "wrangler": "4.158.0"
  }
}
